# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem essas variáveis o site usa dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (o nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY também funciona)

# Importação automática (só no servidor; NUNCA com prefixo NEXT_PUBLIC_)
# Chave secreta do Supabase (Project Settings > API Keys > Secret key, "sb_secret_...").
# O nome antigo SUPABASE_SERVICE_ROLE_KEY também funciona.
SUPABASE_SECRET_KEY=
# Chave da API-Sports (https://dashboard.api-football.com). Serve para futebol, basquete e vôlei.
API_SPORTS_KEY=
# Qualquer texto longo e aleatório. A Vercel usa para chamar /api/cron/importar.
CRON_SECRET=
